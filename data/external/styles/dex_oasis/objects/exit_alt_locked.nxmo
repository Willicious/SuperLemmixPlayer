EFFECT LOCKEDEXIT
TRIGGER_X 19
TRIGGER_Y 40
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 5
DIGIT_X 20
DIGIT_Y -3

$PRIMARY_ANIMATION
  NAME opening
  FRAMES 12
$END


$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 8
  HIDE
  OFFSET_Y 2

  $TRIGGER
    CONDITION Ready
  $END

  $TRIGGER
    CONDITION Exhausted
    STATE LoopToZero
  $END
$END