EFFECT EXIT
TRIGGER_X 20
TRIGGER_Y 28
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 5

SOUND_EXHAUST thunk

$PRIMARY_ANIMATION
  NAME *blank
  FRAMES 1
  WIDTH 42
  HEIGHT 32
$END

$ANIMATION
  NAME main
  FRAMES 6
  
  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END


$ANIMATION
  NAME closing
  FRAMES 15
  INITIAL_FRAME 1
  HIDE
  
  $TRIGGER
    CONDITION Exhausted
    STATE LoopToZero
  $END
$END
