EFFECT TRAP
TRIGGER_X 19
TRIGGER_Y 15
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 4
SOUND weedgulp

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 8
  NAME constant
  
  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END
$END

$ANIMATION
  NAME disabled
  FRAMES 5
  INITIAL_FRAME 1

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 16
  OFFSET_X -3
$END

