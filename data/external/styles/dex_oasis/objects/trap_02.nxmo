EFFECT TRAP
TRIGGER_X 11
TRIGGER_Y 11
TRIGGER_WIDTH 4
TRIGGER_HEIGHT 8
SOUND thud

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 8
  NAME constant
  OFFSET_X -7
  OFFSET_Y -24
  
  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END
$END

$ANIMATION
  NAME disabled
  FRAMES 16
  INITIAL_FRAME 1
  OFFSET_X -7
  OFFSET_Y -24

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 8
$END

