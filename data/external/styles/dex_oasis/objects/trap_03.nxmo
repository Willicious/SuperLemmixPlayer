EFFECT TRAP
TRIGGER_X 20
TRIGGER_Y 28
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 5
SOUND fire

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 6
  NAME constant
  OFFSET_X 0
  OFFSET_Y -2
  
  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 16
$END

