EFFECT TRAPONCE
TRIGGER_X 7
TRIGGER_Y 29
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 4
SOUND thunk

$ANIMATION
  FRAMES 32
  INITIAL_FRAME RANDOM
  NAME constant
  OFFSET_Y 8
  
  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 12
$END
