EFFECT TRAPONCE
TRIGGER_X 4
TRIGGER_Y 16
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 5
SOUND thunk

$ANIMATION
  FRAMES 24
  NAME constant
  OFFSET_X 2
  OFFSET_Y 6
  
  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 24
$END
