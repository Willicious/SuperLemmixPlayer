EFFECT LOCKEDEXIT
TRIGGER_X 13
TRIGGER_Y 18
TRIGGER_WIDTH 4
TRIGGER_HEIGHT 9

SOUND_EXHAUST thunk

$PRIMARY_ANIMATION
  NAME *blank
  FRAMES 10
  WIDTH 30
  HEIGHT 26
$END


$ANIMATION
  NAME opening
  FRAMES 10
  STATE MatchPhysics
  
  $TRIGGER
    CONDITION Ready
    HIDE
  $END
  
  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END


$ANIMATION
  NAME main
  FRAMES 6
  HIDE
  
  $TRIGGER
    CONDITION Ready
  $END
  
  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END


$ANIMATION
  NAME closing
  FRAMES 14
  INITIAL_FRAME 1
  HIDE
  
  $TRIGGER
    CONDITION Exhausted
    STATE LoopToZero
  $END
$END

