EFFECT ENTRANCE
TRIGGER_X 21
TRIGGER_Y 15

$PRIMARY_ANIMATION
  NAME *blank
  FRAMES 10
  WIDTH 42
  HEIGHT 14
$END


$ANIMATION
  NAME opening
  FRAMES 10
  STATE MatchPhysics
  
  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END


$ANIMATION
  NAME closing
  FRAMES 12
  INITIAL_FRAME 1
  HIDE
  
  $TRIGGER
    CONDITION Exhausted
    STATE LoopToZero
  $END
$END
