EFFECT EXIT
TRIGGER_X 14
TRIGGER_Y 36
TRIGGER_WIDTH 3
TRIGGER_HEIGHT 4
DIGIT_X 15

SOUND_EXHAUST thunk

$PRIMARY_ANIMATION
  NAME *blank
  FRAMES 1
  WIDTH 37
  HEIGHT 41
$END

$ANIMATION
  NAME main
  FRAMES 4
  
  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END


$ANIMATION
  NAME closing
  FRAMES 20
  INITIAL_FRAME 1
  HIDE
  
  $TRIGGER
    CONDITION Exhausted
    STATE LoopToZero
  $END
$END
