EFFECT TRAPONCE
TRIGGER_X 8
TRIGGER_Y 8
TRIGGER_WIDTH 5
TRIGGER_HEIGHT 10
SOUND thud

$ANIMATION
  FRAMES 13
  INITIAL_FRAME RANDOM
  NAME constant
  OFFSET_X 5
  OFFSET_Y 1

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 9
$END
