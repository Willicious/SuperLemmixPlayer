EFFECT PICKUPSKILL
TRIGGER_X 1
TRIGGER_Y 9
TRIGGER_WIDTH 4
TRIGGER_HEIGHT 10

DIGIT_X 8
DIGIT_Y 11
DIGIT_ALIGNMENT RIGHT
DIGIT_LENGTH 0

$PRIMARY_ANIMATION
  NAME *PICKUP
  OFFSET_X -9
  OFFSET_Y -3
$END

$ANIMATION
  FRAMES 2
  NAME skill_mask
  HIDE
$END

$ANIMATION
  FRAMES 7
  NAME anim
  OFFSET_X -3
  OFFSET_Y 3

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END