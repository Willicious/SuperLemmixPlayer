EFFECT TRAP
TRIGGER_X 14
TRIGGER_Y 27
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 4
SOUND tenton

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 16
  NAME constant
  OFFSET_Y -2
  
  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END

$ANIMATION
  NAME disabled
  FRAMES 12
  INITIAL_FRAME 1

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END
$END


$PRIMARY_ANIMATION
  FRAMES 25
$END

