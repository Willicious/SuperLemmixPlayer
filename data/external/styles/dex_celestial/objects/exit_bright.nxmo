EFFECT EXIT
TRIGGER_X 18
TRIGGER_Y 48
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 5
DIGIT_Y -4

SOUND_EXHAUST tenton

$PRIMARY_ANIMATION
  NAME *blank
  FRAMES 1
  WIDTH 38
  HEIGHT 52
$END

$ANIMATION
  NAME main
  FRAMES 6
  
  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END


$ANIMATION
  NAME closing
  FRAMES 12
  INITIAL_FRAME 1
  HIDE
  
  $TRIGGER
    CONDITION Exhausted
    STATE LoopToZero
  $END
$END
