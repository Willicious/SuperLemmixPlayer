EFFECT TRAP
TRIGGER_X 20
TRIGGER_Y 27
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 4
SOUND thunk

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 32
  NAME constant
  OFFSET_Y -3
  
  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END


$ANIMATION
  NAME disabled
  FRAMES 24
  INITIAL_FRAME 1

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END
$END


$PRIMARY_ANIMATION
  FRAMES 16
$END

