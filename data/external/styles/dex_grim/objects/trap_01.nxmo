EFFECT TRAP
TRIGGER_X 10
TRIGGER_Y 13
TRIGGER_WIDTH 3
TRIGGER_HEIGHT 4
SOUND tenton

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 12
  NAME constant
  OFFSET_X 6
  
  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END


$ANIMATION
  NAME disabled
  FRAMES 7
  INITIAL_FRAME 1
  OFFSET_X 6

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END
$END


$PRIMARY_ANIMATION
  FRAMES 16
$END

