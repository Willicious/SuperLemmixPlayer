EFFECT TRAP
TRIGGER_X 6
TRIGGER_Y 30
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 6
SOUND thunk

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 16
  NAME constant
  
  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END


$ANIMATION
  NAME disabled
  FRAMES 8
  INITIAL_FRAME 1

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END
$END


$PRIMARY_ANIMATION
  FRAMES 8
$END

