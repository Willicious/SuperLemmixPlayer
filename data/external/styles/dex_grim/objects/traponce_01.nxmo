EFFECT TRAPONCE
TRIGGER_X 5
TRIGGER_Y 29
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 4
SOUND chain

$ANIMATION
  FRAMES 16
  NAME constant
  
  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$ANIMATION
  FRAMES 24
  NAME disabled
  INITIAL_FRAME 1

  $TRIGGER
    HIDE
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 24
$END
