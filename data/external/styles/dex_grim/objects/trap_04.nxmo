EFFECT TRAP
TRIGGER_X 10
TRIGGER_Y 13
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 4
SOUND weedgulp

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 24
  NAME constant
  
  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END


$ANIMATION
  NAME disabled
  FRAMES 12
  INITIAL_FRAME 1

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END
$END


$PRIMARY_ANIMATION
  FRAMES 16
$END

