EFFECT TRAPONCE
TRIGGER_X 4
TRIGGER_Y 21
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 5
SOUND weedgulp

$ANIMATION
  FRAMES 16
  NAME constant
  
  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$ANIMATION
  FRAMES 9
  NAME disabled
  INITIAL_FRAME 1

  $TRIGGER
    HIDE
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 16
$END

