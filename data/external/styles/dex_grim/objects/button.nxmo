EFFECT UNLOCKBUTTON
TRIGGER_X 6
TRIGGER_Y 6
TRIGGER_WIDTH 4
TRIGGER_HEIGHT 11
SOUND lr2_gold

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 8
  NAME constant
  OFFSET_X 2

  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 11
  OFFSET_Y 3
$END
