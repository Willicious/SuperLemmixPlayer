EFFECT TRAP
TRIGGER_X 1
TRIGGER_Y 3
TRIGGER_WIDTH 9
TRIGGER_HEIGHT 8
RESIZE_HORIZONTAL
DEFAULT_WIDTH 8

SOUND thunk

$ANIMATION
  FRAMES 10
  NAME constant
  NINE_SLICE_LEFT 1
  NINE_SLICE_RIGHT 1
  
  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END


$PRIMARY_ANIMATION
  FRAMES 10
  NINE_SLICE_LEFT 1
  NINE_SLICE_RIGHT 1
$END

