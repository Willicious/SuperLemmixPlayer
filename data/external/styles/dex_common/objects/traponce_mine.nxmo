EFFECT TRAPONCE
TRIGGER_X 15
TRIGGER_Y 17
TRIGGER_WIDTH 3
TRIGGER_HEIGHT 12
SOUND thud

$ANIMATION
  FRAMES 4
  NAME constant
  OFFSET_X 13
  OFFSET_Y 17

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 14
$END
