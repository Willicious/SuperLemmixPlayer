EFFECT TRAP
TRIGGER_X -1
TRIGGER_Y 6
TRIGGER_WIDTH 8
TRIGGER_HEIGHT 9
RESIZE_VERTICAL
DEFAULT_HEIGHT 8

SOUND thunk

$ANIMATION
  FRAMES 10
  NAME constant
  NINE_SLICE_TOP 1
  NINE_SLICE_BOTTOM 1
  
  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END


$PRIMARY_ANIMATION
  FRAMES 10
  NINE_SLICE_TOP 1
  NINE_SLICE_BOTTOM 1
$END

