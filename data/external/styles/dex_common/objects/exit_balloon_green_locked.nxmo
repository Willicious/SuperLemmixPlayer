EFFECT LOCKEDEXIT
TRIGGER_X 7
TRIGGER_Y 29
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 4
SOUND_EXHAUST thunk
DIGIT_LENGTH 0

$PRIMARY_ANIMATION
  NAME *blank
  FRAMES 12
  WIDTH 16
  HEIGHT 32
$END


$ANIMATION
  NAME opening
  FRAMES 12
  STATE MatchPhysics
  
  $TRIGGER
    CONDITION Ready
    HIDE
  $END
  
  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END


$ANIMATION
  INITIAL_FRAME RANDOM
  NAME main
  FRAMES 12
  HIDE
    
  $TRIGGER
    CONDITION Ready
  $END
  
  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END


$ANIMATION
  NAME closing
  FRAMES 32
  INITIAL_FRAME 1
  HIDE
  
  $TRIGGER
    CONDITION Exhausted
    STATE LoopToZero
  $END
$END
