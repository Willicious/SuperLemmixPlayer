EFFECT TRAPONCE
TRIGGER_X 4
TRIGGER_Y 5
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 9
SOUND weedgulp

$ANIMATION
  FRAMES 13
  NAME constant
  
  $TRIGGER
    CONDITION BUSY
    HIDE
  $END

  $TRIGGER
    CONDITION DISABLED
    HIDE
  $END

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$PRIMARY_ANIMATION
  FRAMES 6
$END
