EFFECT PICKUPSKILL
TRIGGER_X 4
TRIGGER_Y 6
TRIGGER_WIDTH 4
TRIGGER_HEIGHT 10

DIGIT_X 11
DIGIT_Y 8
DIGIT_ALIGNMENT RIGHT
DIGIT_LENGTH 0

$PRIMARY_ANIMATION
  NAME *PICKUP
  OFFSET_X -6
  OFFSET_Y -6
$END

$ANIMATION
  FRAMES 2
  NAME skill_mask
  HIDE
$END

$ANIMATION
  FRAMES 7
  NAME border
  COLOR pickup_border

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END

$ANIMATION
  FRAMES 7
  NAME inside
  COLOR pickup_inside

  $TRIGGER
    CONDITION EXHAUSTED
    HIDE
  $END
$END