EFFECT EXIT
TRIGGER_X 17
TRIGGER_Y 32
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 5

SOUND_EXHAUST thunk

$PRIMARY_ANIMATION
  NAME *blank
  FRAMES 5
  WIDTH 36
  HEIGHT 36
$END

$ANIMATION
  INITIAL_FRAME RANDOM
  NAME main
  FRAMES 6
  
  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END


$ANIMATION
  NAME closing
  FRAMES 12
  INITIAL_FRAME 1
  HIDE
  
  $TRIGGER
    CONDITION Exhausted
    STATE LoopToZero
  $END
$END

