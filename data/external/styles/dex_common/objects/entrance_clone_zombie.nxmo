EFFECT ENTRANCE
TRIGGER_X 13
TRIGGER_Y 20

DIGIT_X 4
DIGIT_Y 2
DIGIT_LENGTH 0

$PRIMARY_ANIMATION
  NAME *blank
  FRAMES 10
  WIDTH 40
  HEIGHT 25
$END


$ANIMATION
  NAME opening
  FRAMES 10
  STATE MatchPhysics

  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END

$ANIMATION
  NAME main
  FRAMES 8
  STATE Pause

  $TRIGGER
    CONDITION Ready
    STATE Play
  $END

  $TRIGGER
    CONDITION Exhausted
    STATE Pause
  $END
$END

$ANIMATION
  NAME constant
  FRAMES 8
  STATE Pause
  HIDE

  $TRIGGER
    CONDITION Ready
    STATE Play
  $END

  $TRIGGER
    CONDITION Exhausted
    HIDE
  $END
$END

$ANIMATION
  NAME closing
  FRAMES 13
  INITIAL_FRAME 1
  HIDE
  
  $TRIGGER
    CONDITION Exhausted
    STATE LoopToZero
  $END
$END


