EFFECT TRAP
TRIGGER_X 42
TRIGGER_Y 32
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 5
SOUND thud

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 6
  NAME constant
  OFFSET_X 4
  OFFSET_Y -1
  
  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END


$PRIMARY_ANIMATION
  FRAMES 8
$END

