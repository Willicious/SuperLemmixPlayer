EFFECT TRAP
TRIGGER_X 10
TRIGGER_Y 29
TRIGGER_WIDTH 2
TRIGGER_HEIGHT 4
SOUND fire

$ANIMATION
  INITIAL_FRAME RANDOM
  FRAMES 12
  NAME constant
  
  $TRIGGER
    CONDITION DISABLED
    STATE LOOPTOZERO
  $END

  $TRIGGER
    CONDITION BUSY
    HIDE
  $END
$END


$PRIMARY_ANIMATION
  FRAMES 16
$END

